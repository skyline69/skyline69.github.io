---
/**
 * The whole site: four scenes on one stage.
 */
import type { CollectionEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Stage from '../components/Stage.astro';
import IntroScene from '../components/scenes/IntroScene.astro';
import WorkScene, { type WorkProject } from '../components/scenes/WorkScene.astro';
import StackScene from '../components/scenes/StackScene.astro';
import MeScene, { type MeCard } from '../components/scenes/MeScene.astro';
import { getActiveHighlights, getActiveProjects, getProfile, getStack } from '../lib/content';
import { fillAge, getAge } from '../lib/date';
import { buildJsonLd, serializeJsonLd } from '../lib/seo';
import { DEFAULT_SITE, siteMeta, type SiteMeta } from '../lib/site';
import type { StackItem } from '../lib/stack';

const [profileEntry, projectEntries, highlightEntries, stack] = await Promise.all([
  getProfile(),
  getActiveProjects(),
  getActiveHighlights(),
  getStack(),
]);

const profile: CollectionEntry<'profile'>['data'] = profileEntry.data;
const age: number = getAge(profile.birthDate);
const siteUrl: string = (Astro.site ?? DEFAULT_SITE).href;
const { title, description }: SiteMeta = siteMeta(profile);

const projects: WorkProject[] = projectEntries.map((entry: CollectionEntry<'projects'>): WorkProject => {
  const p: CollectionEntry<'projects'>['data'] = entry.data;
  return {
    title: p.title,
    description: p.description,
    note: p.note,
    tags: p.tags,
    archived: p.status === 'archived',
    href: p.siteUrl ?? p.repoUrl,
    linkLabel: p.siteUrl === undefined ? 'View on GitHub' : 'Visit the site',
    repoUrl: p.repoUrl,
    showRepoLink: p.siteUrl !== undefined,
    image: p.image,
    visual: p.visual,
  };
});

const cards: MeCard[] = highlightEntries.map(
  (entry: CollectionEntry<'highlights'>): MeCard => ({
    title: entry.data.title,
    body: entry.data.body,
    accent: entry.data.accent,
  }),
);

const jsonLd: string = serializeJsonLd(
  buildJsonLd(
    {
      name: profile.name,
      handle: profile.handle,
      siteUrl,
      githubUrl: profile.githubUrl,
      description,
      knowsAbout: stack.map((item: StackItem): string => item.name),
    },
    projectEntries.map((entry: CollectionEntry<'projects'>) => ({
      title: entry.data.title,
      description: entry.data.description,
      repoUrl: entry.data.repoUrl,
      siteUrl: entry.data.siteUrl,
      languages: entry.data.tags,
      archived: entry.data.status === 'archived',
    })),
  ),
);
---

<Layout title={title} description={description} author={profile.name} jsonLd={jsonLd}>
  <SiteHeader name={profile.name} githubUrl={profile.githubUrl} />
  <Stage>
    <IntroScene
      name={profile.name}
      headline={profile.headline}
      headlineAccent={profile.headlineAccent}
      intro={profile.intro}
      githubUrl={profile.githubUrl}
    />
    <WorkScene projects={projects} />
    <StackScene items={stack} />
    <MeScene
      name={profile.name}
      summary={profile.summary.map((text: string): string => fillAge(text, age))}
      origin={profile.origin}
      languages={profile.languages}
      next={profile.next}
      cards={cards}
      githubUrl={profile.githubUrl}
    />
  </Stage>
</Layout>

<script>
  import '../scripts/main';
</script>
