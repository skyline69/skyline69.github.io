---
/**
 * Server error pages (/errors/500/ and so on). GitHub Pages never answers with a 5xx; these
 * are for Cloudflare to serve when the origin fails, via its Error Pages or Custom Error
 * Rules. They ship no bundled script, since Cloudflare inlines everything they reference.
 */
import ErrorPage from '../../components/ErrorPage.astro';
import { SERVER_ERROR_CODES, type ErrorCode } from '../../lib/i18n';

interface Props {
  code: Exclude<ErrorCode, 404>;
}

interface ErrorPath {
  params: { code: string };
  props: Props;
}

export function getStaticPaths(): ErrorPath[] {
  return SERVER_ERROR_CODES.map(
    (code: Exclude<ErrorCode, 404>): ErrorPath => ({ params: { code: String(code) }, props: { code } }),
  );
}

const { code }: Props = Astro.props;
---

<ErrorPage code={code} />
