---
/**
 * Fixed header: name, scene nav, scene counter, language menu and GitHub link.
 * The controller keeps `aria-current` and the counter in sync.
 */
import Icon from './Icon.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { MESSAGES, type Locale, type Messages } from '../lib/i18n';
import { SCENE_IDS, formatCounter, type SceneId } from '../lib/scenes/state';

interface Props {
  locale: Locale;
  name: string;
  githubUrl: string;
}

const { locale, name, githubUrl }: Props = Astro.props;
const t: Messages = MESSAGES[locale];
---

<header class="site-header">
  <a class="brand" href="#intro">{name}</a>
  <nav class="nav" aria-label={t.scenesNav}>
    <ul>
      {
        SCENE_IDS.map((id: SceneId) => (
          <li>
            <a class="nav-link" href={`#${id}`} data-nav={id} aria-current={id === 'intro' ? 'true' : undefined}>
              {t.sceneLabels[id]}
            </a>
          </li>
        ))
      }
    </ul>
    <span class="nav-indicator" data-nav-indicator aria-hidden="true"></span>
  </nav>
  <div class="header-end">
    <span class="counter" data-counter aria-hidden="true">{formatCounter(0, SCENE_IDS.length)}</span>
    <LanguageSwitcher locale={locale} />
    <a class="header-github" href={githubUrl}>GitHub<Icon name="arrow-up-right" size={14} /></a>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 20;
    height: calc(var(--header-h) + env(safe-area-inset-top));
    padding-top: env(safe-area-inset-top);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 16px;
    padding-left: calc(var(--gutter) + env(safe-area-inset-left));
    padding-right: calc(var(--gutter) + env(safe-area-inset-right));
    isolation: isolate;
  }

  /* Blurred, darkened backdrop that fades out at the bottom, so scrolled scene content
     slides under the nav instead of colliding with it. */
  .site-header::before {
    content: '';
    position: absolute;
    inset: 0 0 -24px;
    z-index: -1;
    background: linear-gradient(to bottom, rgba(0, 0, 0, 0.9) 55%, rgba(0, 0, 0, 0));
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    -webkit-mask-image: linear-gradient(to bottom, #000 60%, transparent);
    mask-image: linear-gradient(to bottom, #000 60%, transparent);
    pointer-events: none;
  }

  .brand {
    justify-self: start;
    color: var(--ink);
    font-size: clamp(19px, 1.55vw, 22px);
  }

  .brand:hover {
    color: var(--ink);
  }

  .nav {
    position: relative;
  }

  .nav ul {
    display: flex;
    gap: 4px;
  }

  /* One shared underline, moved by the script. Hidden until it is measured. */
  .nav-indicator {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 0;
    height: 1px;
    background: var(--orchid);
    box-shadow: 0 0 10px rgba(142, 5, 194, 0.9);
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
  }

  .nav-link {
    display: block;
    padding: 12px clamp(8px, 1.1vw, 16px);
    color: var(--haze);
    font-size: var(--text-base);
    border-bottom: 1px solid transparent;
    transition: color 0.45s ease;
  }

  .nav-link:hover {
    color: var(--ink);
    text-decoration: none;
  }

  .nav-link[aria-current='true'] {
    color: var(--ink);
  }

  /* Without the script the underline sits on the tab itself. */
  :global(html:not(.js)) .nav-link[aria-current='true'] {
    border-bottom-color: var(--orchid);
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-link {
      transition: none;
    }
  }

  .header-end {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 28px;
    font-size: var(--text-base);
  }

  .counter {
    color: var(--haze);
    font-variant-numeric: tabular-nums;
  }

  /* Rolling digits, built by lib/motion/counter.ts. Each digit is a small window; during a
     roll the incoming glyph sits on top of the outgoing one and the edges fade out. The mask
     clips the window; side padding (cancelled by margin) keeps a wider glyph from being cut
     while the width eases. */
  .counter :global(.counter-digit) {
    position: relative;
    display: inline-block;
    box-sizing: content-box;
    padding: 0 0.3em;
    margin: 0 -0.3em;
    vertical-align: bottom;
    -webkit-mask-image: linear-gradient(to bottom, transparent, #000 25%, #000 75%, transparent);
    mask-image: linear-gradient(to bottom, transparent, #000 25%, #000 75%, transparent);
  }

  .counter :global(.counter-glyph) {
    display: inline-block;
  }

  .counter :global(.counter-glyph--float) {
    position: absolute;
    top: 0;
    left: 0.3em;
  }

  .header-github {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  @media (max-width: 768px) {
    .site-header {
      grid-template-columns: auto 1fr auto;
      gap: 8px;
    }

    .nav {
      justify-self: end;
    }

    /* Only the language menu stays on small screens. */
    .counter,
    .header-github {
      display: none;
    }
  }

  @media (max-width: 480px) {
    .nav-link {
      padding: 12px 7px;
    }
  }
</style>
