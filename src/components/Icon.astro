---
/**
 * Inline stroke icons. Decorative only: always hidden from assistive tech.
 */
interface Props {
  name: 'arrow-right' | 'arrow-left' | 'arrow-up-right';
  size?: number;
}

const { name, size = 16 }: Props = Astro.props;
---

<svg
  class="icon"
  width={size}
  height={size}
  viewBox="0 0 16 16"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {name === 'arrow-right' && <path d="M2 8h12M9.5 3.5 14 8l-4.5 4.5" />}
  {name === 'arrow-left' && <path d="M14 8H2m4.5-4.5L2 8l4.5 4.5" />}
  {name === 'arrow-up-right' && <path d="M4 12 12 4M5.5 4H12v6.5" />}
</svg>
